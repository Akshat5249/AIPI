FROM python:3.12-slim-bookworm
WORKDIR /app
RUN pip install --no-cache-dir uv==0.11.21
COPY pyproject.toml uv.lock ./
COPY apps/api apps/api
COPY packages packages
COPY services/demo-services services/demo-services
RUN uv sync --frozen --all-packages --no-dev
COPY runbooks runbooks
COPY infra/docker/alembic.ini alembic.ini
COPY infra/docker/migrations migrations
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
RUN useradd --create-home --uid 10001 aipi
USER aipi
CMD ["uvicorn", "aipi_api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
