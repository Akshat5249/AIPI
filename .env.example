# Copy to .env and set lab-only passwords, or run make setup-env to generate them.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://investigator_ro:replace_me@localhost:5432/aipi
TELEMETRY_DATABASE_URL=postgresql+psycopg://telemetry_writer:replace_me@localhost:5432/aipi
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
MODEL_PROVIDER=mock
MODEL_NAME=deterministic-mock
MODEL_API_KEY=
POSTGRES_PASSWORD=replace_me
REPLICATION_PASSWORD=replace_me
APP_RW_PASSWORD=replace_me
APP_RO_PASSWORD=replace_me
INVESTIGATOR_PASSWORD=replace_me
TELEMETRY_WRITER_PASSWORD=replace_me
CHAOS_PASSWORD=replace_me
TRAFFIC_SEED=42
TRAFFIC_RPS=1
REDACT_EMAILS=true

# Optional host-only view connection; Compose supplies the restricted replica URL.
# REPLICA_DATABASE_URL=postgresql+psycopg://investigator_ro:replace_me@localhost:5433/aipi
RUNBOOKS_PATH=runbooks
